# Logs
log/

# Datasets - ignore all data content
data/compressed/*
data/uncompressed/*
data/splitted/*

# Keep README files in dataset folders
!data/compressed/README*
!data/uncompressed/README*
!data/splitted/README*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
ENV/
.venv

# Pipenv
Pipfile.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Testing
.pytest_cache/
.coverage
htmlcov/

# Model files (optional - uncomment if you want to ignore saved models)
# *.pth
# *.pkl
# *.h5
# *.onnx

# OS
Thumbs.db
.DS_Store

# Temporary files
*.tmp
*.bak
.env
scripts/

# Raw dataset archives and recovered run logs (multi-GB, and the dataset is
# clinical data - never commit these to a public repo)
*.zip

# Windows "downloaded from the internet" metadata
*:Zone.Identifier

# torch hub cache created by the docker runs
.cache/

# ---- bench-v2 additions ----
# Everything superseded lives here; never committed, never deleted.
archive/
# Datasets and run outputs in full (the earlier rules only covered subdirs)
data/
log/
# Model artefacts and raw arrays
*.pth
*.pkl
*.npy
*.npz
